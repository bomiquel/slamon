<?xml version="1.0"?>
<package format="2">

    <name>slamon</name>
    <version>1.2.5</version>

    <description>
       SLAMON is an improved and extended version of stereo_slam.
       Like the original project, it implements a stereo visual SLAM 
       system designed for underwater environments.

       SLAMON runs three main threads:
       1. A robust visual odometer for underwater environments.
       2. A topological map creator where the nodes are clusters 
          of keypoints and the edges are the number of matches 
          and the relative movement between nodes.
       3. A loop closer that detects revisited areas by proximity and hashes.
    </description>

    <url type = "website">https://github.com/bomiquel/slamon</url>
    <url type = "bugtracker">https://github.com/bomiquel/slamon/issues</url>
    <url type = "repository">https://github.com/bomiquel/slamon</url>

    <author email = "bo-miquel.nordfeldt@uib.cat">Bo Miquel Nordfeldt-Fiol</author>
    <maintainer email = "bo-miquel.nordfeldt@uib.cat">Bo Miquel Nordfeldt-Fiol</maintainer>

    <!--
        Licensing notice:
        - The project includes original code from stereo_slam and libhaloc (2013) under BSD-4-Clause.
        - All modifications by Bo Miquel Nordfeldt-Fiol are under BSD-4-Clause too.
    -->
    <license>BSD-4-Clause</license>

    <!-- Build tool -->
    <buildtool_depend>catkin</buildtool_depend>

    <!-- System Dependencies -->
    <depend>eigen</depend> 
    <depend>libsuitesparse-dev</depend>

    <!-- ROS Dependencies (Build + Exec) -->
    <depend>tf2</depend>
    <depend>roscpp</depend>
    <depend>libg2o</depend>
    <depend>tf2_ros</depend>
    <depend>std_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>cv_bridge</depend>
    <depend>sensor_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>rosgraph_msgs</depend>
    <depend>image_geometry</depend>
    <depend>image_transport</depend>
    <depend>message_filters</depend>
    <depend>tf2_geometry_msgs</depend>

    <!-- Only Build -->
    <build_depend>cmake_modules</build_depend>
    <build_depend>message_generation</build_depend>

    <!-- Only Exec -->
    <exec_depend>message_runtime</exec_depend>

    <export>
    </export>

</package>
