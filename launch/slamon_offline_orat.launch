<launch>

    <!-- Robots parameters -->
    <arg name = "robot_name"         default = "sparus2"/>

    <!-- Camera parameters -->
    <arg name = "camera_name"        default = "flir_spinnaker_stereo_camera"/>
    <arg name = "resolution"         default = "full"/>
    <arg name = "slave_camera_name"  default = "starboard"/>
    <arg name = "master_camera_name" default = "port"/>

    <!-- Image flags -->
    <arg name = "enable_decimate_x1" default = "false"/>
    <arg name = "enable_decimate_x2" default = "false"/>
    <arg name = "enable_decimate_x4" default = "true"/>
    <arg name = "enable_decimate_x8" default = "false"/>

    <!-- CPU/MEM monitor flag -->
    <arg name = "enable_cpu_monitor" default = "true"/>

    <!-- Clock extension -->
    <arg name = "enable_extra_clock" default = "true"/>

    <!-- Bagfiles parameters -->
    <param name = "/use_sim_time"    value = "true"/>

    <!-- Andratx -->
    <arg name = "bagfile" default = "/home/bomiquel/datasets/bagfiles/andratx/2025_06_25/10_36_48_cut/sparus2_stereo_camera_2025-06-25-10-36-48_0.bag
                                     /home/bomiquel/datasets/bagfiles/andratx/2025_06_25/10_36_48_cut/sparus2_stereo_camera_2025-06-25-10-39-17_1.bag
                                     /home/bomiquel/datasets/bagfiles/andratx/2025_06_25/10_36_48_cut/sparus2_stereo_camera_2025-06-25-10-40-17_2.bag
                                     /home/bomiquel/datasets/bagfiles/andratx/2025_06_25/10_36_48_cut/sparus2_stereo_camera_2025-06-25-10-41-16_3.bag
                                     /home/bomiquel/datasets/bagfiles/andratx/2025_06_25/10_36_48_cut/sparus2_stereo_camera_2025-06-25-10-42-16_4.bag"/>
    <!-- <arg name = "bagfile" default = "/home/bomiquel/datasets/bagfiles/andratx/2025_06_25/10_15_11_cut_sparus3/sparus2_stereo_camera_2025-06-25-10-15-11_0.bag
                                     /home/bomiquel/datasets/bagfiles/andratx/2025_06_25/10_15_11_cut_sparus3/sparus2_stereo_camera_2025-06-25-10-18-02_1.bag
                                     /home/bomiquel/datasets/bagfiles/andratx/2025_06_25/10_15_11_cut_sparus3/sparus2_stereo_camera_2025-06-25-10-19-01_2.bag
                                     /home/bomiquel/datasets/bagfiles/andratx/2025_06_25/10_15_11_cut_sparus3/sparus2_stereo_camera_2025-06-25-10-20-02_3.bag
                                     /home/bomiquel/datasets/bagfiles/andratx/2025_06_25/10_15_11_cut_sparus3/sparus2_stereo_camera_2025-06-25-10-21-02_4.bag
                                     /home/bomiquel/datasets/bagfiles/andratx/2025_06_25/10_15_11_cut_sparus3/sparus2_stereo_camera_2025-06-25-10-22-01_5.bag"/> -->

    <group ns = "$(arg robot_name)">

        <!-- Processes stereo images -->
        <include file = "$(find slamon)/launch/stereo_processing/stereo_pipeline.launch">
            <arg name = "stereo"             value = "$(arg camera_name)"/>
            <arg name = "resolution"         value = "$(arg resolution)"/>
            <arg name = "slave_camera_name"  value = "$(arg slave_camera_name)"/>
            <arg name = "master_camera_name" value = "$(arg master_camera_name)"/>
            <arg name = "enable_decimate_x1" value = "$(arg enable_decimate_x1)"/>
            <arg name = "enable_decimate_x2" value = "$(arg enable_decimate_x2)"/>
            <arg name = "enable_decimate_x4" value = "$(arg enable_decimate_x4)"/>
            <arg name = "enable_decimate_x8" value = "$(arg enable_decimate_x8)"/>
        </include>

        <include file="$(find slamon)/launch/marine_stereo_processing/voxel_grid.launch">
            <arg name="input_topic" value="/$(arg robot_name)/slamon_map/keycloud"/>
            <arg name="output_topic" value="/$(arg robot_name)/slamon_map/keycloud_filtered"/>
        </include>

        <!-- VO SLAMON -->
        <rosparam command = "load" file = "$(find slamon)/config/offline_params.yaml"/>
        <node pkg = "slamon" type = "slamon_vo" name = "slamon_vo" output = "screen" if = "$(eval enable_decimate_x1 == true)">
            <remap from = "get_first_odom"              to = "slamon_vo/get_first_odom"/>
            <remap from = "left_camera_info"            to = "$(arg camera_name)/$(arg master_camera_name)/camera_info"/>
            <remap from = "right_camera_info"           to = "$(arg camera_name)/$(arg slave_camera_name)/camera_info"/>
            <remap from = "left_image_rect_color"       to = "$(arg camera_name)/$(arg master_camera_name)/image_rect_color"/>
            <remap from = "right_image_rect_color"      to = "$(arg camera_name)/$(arg slave_camera_name)/image_rect_color"/> 
        </node>
        <node pkg = "slamon" type = "slamon_vo" name = "slamon_vo" output = "screen" if = "$(eval enable_decimate_x2 == true)">
            <remap from = "get_first_odom"              to = "slamon_vo/get_first_odom"/>
            <remap from = "left_camera_info"            to = "$(arg camera_name)/scaled_x2/$(arg master_camera_name)/camera_info"/>
            <remap from = "right_camera_info"           to = "$(arg camera_name)/scaled_x2/$(arg slave_camera_name)/camera_info"/>
            <remap from = "left_image_rect_color"       to = "$(arg camera_name)/scaled_x2/$(arg master_camera_name)/image_rect_color"/>
            <remap from = "right_image_rect_color"      to = "$(arg camera_name)/scaled_x2/$(arg slave_camera_name)/image_rect_color"/> 
        </node>
        <node pkg = "slamon" type = "slamon_vo" name = "slamon_vo" output = "screen" if = "$(eval enable_decimate_x4 == true)">
            <remap from = "get_first_odom"              to = "slamon_vo/get_first_odom"/>
            <remap from = "left_camera_info"            to = "$(arg camera_name)/scaled_x4/$(arg master_camera_name)/camera_info"/>
            <remap from = "right_camera_info"           to = "$(arg camera_name)/scaled_x4/$(arg slave_camera_name)/camera_info"/>
            <remap from = "left_image_rect_color"       to = "$(arg camera_name)/scaled_x4/$(arg master_camera_name)/image_rect_color"/>
            <remap from = "right_image_rect_color"      to = "$(arg camera_name)/scaled_x4/$(arg slave_camera_name)/image_rect_color"/> 
        </node>

        <!-- MAP SLAMON -->
        <node pkg = "slamon" type = "slamon_map" name = "slamon_map" output = "screen" if = "$(eval enable_decimate_x1 == true)">
            <remap from = "odom"                        to = "slamon_vo/robot_odom"/>
            <remap from = "points2"                     to = "$(arg camera_name)/points2"/>
            <remap from = "keyframe"                    to = "slamon_vo/keyframe"/>
            <remap from = "get_robot_to_camera_tf"      to = "slamon_vo/send_robot_to_camera_tf"/>
            <remap from = "get_projection_matrices"     to = "slamon_vo/send_projection_matrices"/>
        </node>
        <node pkg = "slamon" type = "slamon_map" name = "slamon_map" output = "screen" if = "$(eval enable_decimate_x2 == true)">
            <remap from = "odom"                        to = "slamon_vo/robot_odom"/>
            <remap from = "points2"                     to = "$(arg camera_name)/scaled_x2/points2"/>
            <remap from = "keyframe"                    to = "slamon_vo/keyframe"/>
            <remap from = "get_robot_to_camera_tf"      to = "slamon_vo/send_robot_to_camera_tf"/>
            <remap from = "get_projection_matrices"     to = "slamon_vo/send_projection_matrices"/>
        </node>
        <node pkg = "slamon" type = "slamon_map" name = "slamon_map" output = "screen" if = "$(eval enable_decimate_x4 == true)">
            <remap from = "odom"                        to = "slamon_vo/robot_odom"/>
            <remap from = "points2"                     to = "$(arg camera_name)/scaled_x4/points2"/>
            <remap from = "keyframe"                    to = "slamon_vo/keyframe"/>
            <remap from = "get_robot_to_camera_tf"      to = "slamon_vo/send_robot_to_camera_tf"/>
            <remap from = "get_projection_matrices"     to = "slamon_vo/send_projection_matrices"/>
        </node>

    </group>

    <!-- Extend clok -->
    <node pkg = "slamon" type = "clock_extender" name = "clock_extender" required = "true" output = "screen" if = "$(eval enable_extra_clock == true)">
        <param name = "extra_time"       value = "16"/>
        <param name = "gap_threshold"    value = "1.5"/>
        <param name = "watch_interval"   value = "1.5"/>
    </node>

    <!-- CPU/RAM memory monitor -->
    <node pkg = "cpu_monitor" name = "cpu_monitor" type = "monitor.py" output = "screen" if = "$(eval enable_cpu_monitor == true)"/>

    <!-- Play bagfile -->
    <node pkg = "slamon" 
          type = "rosbag_play_with_delay.sh" 
          name = "rosbag" 
          args = "-r 1 --clock $(arg bagfile) --topics /$(arg robot_name)/$(arg camera_name)/$(arg master_camera_name)/camera_info 
                                                       /$(arg robot_name)/$(arg camera_name)/$(arg master_camera_name)/image_raw 
                                                       /$(arg robot_name)/$(arg camera_name)/$(arg slave_camera_name)/camera_info 
                                                       /$(arg robot_name)/$(arg camera_name)/$(arg slave_camera_name)/image_raw
                                                       /$(arg robot_name)/navigator/odometry"
          if = "$(eval enable_extra_clock == true)"/>

    <node pkg = "slamon" 
          type = "rosbag_play_with_delay.sh" 
          name = "rosbag" 
          args = "-r 1 --clock $(arg bagfile) --topics /$(arg robot_name)/$(arg camera_name)/$(arg master_camera_name)/camera_info 
                                                       /$(arg robot_name)/$(arg camera_name)/$(arg master_camera_name)/image_raw 
                                                       /$(arg robot_name)/$(arg camera_name)/$(arg slave_camera_name)/camera_info 
                                                       /$(arg robot_name)/$(arg camera_name)/$(arg slave_camera_name)/image_raw
                                                       /$(arg robot_name)/navigator/odometry"
          required = "true"
          if = "$(eval enable_extra_clock == false)"/>

</launch>