<launch>
    <arg name="config"/>
    <rosparam command="load" file="$(find stereo_slam)/config/multimaster/$(arg config)"/>
    <node name="master_discovery" pkg="fkie_master_discovery" type="master_discovery" output="log" respawn="true">
        <param name="mcast_group" value="224.0.0.1"/>
    </node>
    <node name="master_sync" pkg="fkie_master_sync" type="master_sync" output="log" respawn="true"/>
</launch>