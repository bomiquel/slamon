<launch>

    <!-- Robots parameters -->
    <arg name = "robot_name"         default = "lanty"/>

    <!-- Image parameters -->
    <arg name = "camera"             default = "stereo_ch3"/>
    <arg name = "resolution"         default = "full"/>
    <arg name = "enable_decimate_x1" default = "false"/>
    <arg name = "enable_decimate_x2" default = "false"/>
    <arg name = "enable_decimate_x4" default = "true"/>

    <node pkg="tf" type = "static_transform_publisher" name = "base_link_to_stereo" args = "0 0 0 0 0 0 1 /lanty/base_link /camera_left 50" />

    <group ns = "$(arg robot_name)">

        <!-- Initial pose and orientation parameters -->  
        <arg name = "t_x" default = "0.0"/> 
        <arg name = "t_y" default = "0.0"/> 
        <arg name = "t_z" default = "0.0"/> 
        <arg name = "q_x" default = "0.0"/>
        <arg name = "q_y" default = "0.0"/>
        <arg name = "q_z" default = "0.0"/>
        <arg name = "q_w" default = "1.0"/>

        <!-- Viso2 -->
        <rosparam command="load" file="$(find viso2_ros)/config/viso2_stereo_parameters.yaml"/>
        <include file = "$(find viso2_ros)/launch/stereo_odometer_auto3.launch">
            <arg name = "robot"                 value = "$(arg robot_name)"/>
            <arg name = "resolution"            value = "$(arg resolution)" />
            <arg name = "camera"                value = "/$(arg camera)"/>
            <arg name = "enable_decimate_x1"    value = "$(arg enable_decimate_x1)"/>
            <arg name = "enable_decimate_x2"    value = "$(arg enable_decimate_x2)"/>
            <arg name = "enable_decimate_x4"    value = "$(arg enable_decimate_x4)"/>
            <arg name = "trans_x"               value = "$(arg t_x)"/> <!-- N -->
            <arg name = "trans_y"               value = "$(arg t_y)"/> <!-- E -->
            <arg name = "trans_z"               value = "$(arg t_z)"/> <!-- A -->
            <arg name = "rot_x"                 value = "$(arg q_x)"/>
            <arg name = "rot_y"                 value = "$(arg q_y)"/>
            <arg name = "rot_z"                 value = "$(arg q_z)"/>
            <arg name = "rot_w"                 value = "$(arg q_w)"/>
            <arg name = "odom_frame_name"       value = "/odom"/>
            <arg name = "sensor_frame_name"     value = "/camera_left"/>
            <arg name = "base_link_frame_name"  value = "/$(arg robot_name)/base_link"/>
        </include>

        <!-- SLAMON -->
        <rosparam command="load" file="$(find slamon)/config/slamon_parameters.yaml"/>
        <node pkg="slamon" type="localization" name="slamon" output="screen" if = "$(eval enable_decimate_x1 == true)">
            <remap from = "odom"                        to = "stereo_odometer/odometry"/>
            <remap from = "left_camera_info"            to = "/$(arg camera)/left/camera_info"/>
            <remap from = "right_camera_info"           to = "/$(arg camera)/right/camera_info"/>
            <remap from = "left_image_rect_color"       to = "/$(arg camera)/left/image_rect_color"/>
            <remap from = "right_image_rect_color"      to = "/$(arg camera)/right/image_rect_color"/> 
            <param name = "map_frame_name"              value = "/map"/>
        </node>
        <node pkg="slamon" type="localization" name="slamon" output="screen" if = "$(eval enable_decimate_x2 == true)">
            <remap from = "odom"                        to = "stereo_odometer/odometry"/>
            <remap from = "left_camera_info"            to = "/$(arg camera)/scaled_x2/left/camera_info"/>
            <remap from = "right_camera_info"           to = "/$(arg camera)/scaled_x2/right/camera_info"/>
            <remap from = "left_image_rect_color"       to = "/$(arg camera)/scaled_x2/left/image_rect_color"/>
            <remap from = "right_image_rect_color"      to = "/$(arg camera)/scaled_x2/right/image_rect_color"/> 
            <param name = "map_frame_name"              value = "/map"/>
        </node>
        <node pkg="slamon" type="localization" name="slamon" output="screen" if = "$(eval enable_decimate_x4 == true)">
            <remap from = "odom"                        to = "stereo_odometer/odometry"/>
            <remap from = "left_camera_info"            to = "/$(arg camera)/scaled_x4/left/camera_info"/>
            <remap from = "right_camera_info"           to = "/$(arg camera)/scaled_x4/right/camera_info"/>
            <remap from = "left_image_rect_color"       to = "/$(arg camera)/scaled_x4/left/image_rect_color"/>
            <remap from = "right_image_rect_color"      to = "/$(arg camera)/scaled_x4/right/image_rect_color"/> 
            <param name = "map_frame_name"              value = "/map"/>
        </node>
    </group>
</launch>