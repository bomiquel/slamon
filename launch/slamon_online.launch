<launch>

    <!-- Robots parameters -->
    <arg name = "robot_name"         default = "turbot"/>

    <!-- Image parameters -->
    <arg name = "camera"             default = "stereo_down"/>
    <arg name = "resolution"         default = "full"/>
    <arg name = "enable_decimate_x1" default = "false"/>
    <arg name = "enable_decimate_x2" default = "false"/>
    <arg name = "enable_decimate_x4" default = "true"/>
    <arg name = "enable_decimate_x8" default = "false"/>

    <group ns = "$(arg robot_name)">

        <!-- VO SLAMON -->
        <rosparam command="load" file="$(find slamon)/config/slamon_parameters.yaml"/>
        <node pkg = "slamon" type = "vo_slamon" name = "vo_slamon" output = "screen" if = "$(eval enable_decimate_x1 == true)">
            <remap from = "get_first_pose"              to = "vo_slamon/get_first_pose"/>
            <remap from = "left_camera_info"            to = "/$(arg camera)/left/camera_info"/>
            <remap from = "right_camera_info"           to = "/$(arg camera)/right/camera_info"/>
            <remap from = "left_image_rect_color"       to = "/$(arg camera)/left/image_rect_color"/>
            <remap from = "right_image_rect_color"      to = "/$(arg camera)/right/image_rect_color"/> 
        </node>
        <node pkg = "slamon" type = "vo_slamon" name = "vo_slamon" output = "screen" if = "$(eval enable_decimate_x2 == true)">
            <remap from = "get_first_pose"              to = "vo_slamon/get_first_pose"/>
            <remap from = "left_camera_info"            to = "/$(arg camera)/scaled_x2/left/camera_info"/>
            <remap from = "right_camera_info"           to = "/$(arg camera)/scaled_x2/right/camera_info"/>
            <remap from = "left_image_rect_color"       to = "/$(arg camera)/scaled_x2/left/image_rect_color"/>
            <remap from = "right_image_rect_color"      to = "/$(arg camera)/scaled_x2/right/image_rect_color"/> 
        </node>
        <node pkg = "slamon" type = "vo_slamon" name = "vo_slamon" output = "screen" if = "$(eval enable_decimate_x4 == true)">
            <remap from = "get_first_pose"              to = "vo_slamon/get_first_pose"/>
            <remap from = "left_camera_info"            to = "/$(arg camera)/scaled_x4/left/camera_info"/>
            <remap from = "right_camera_info"           to = "/$(arg camera)/scaled_x4/right/camera_info"/>
            <remap from = "left_image_rect_color"       to = "/$(arg camera)/scaled_x4/left/image_rect_color"/>
            <remap from = "right_image_rect_color"      to = "/$(arg camera)/scaled_x4/right/image_rect_color"/> 
        </node>

        <!-- MAP SLAMON -->
        <node pkg = "slamon" type = "map_slamon" name = "map_slamon" output = "screen">
            <remap from = "odom"                        to = "vo_slamon/robot_odom"/>
            <remap from = "stereo_data"                 to = "vo_slamon/stereo_data"/>
            <remap from = "get_robot_to_camera_tf"      to = "vo_slamon/send_robot_to_camera_tf"/>
            <remap from = "get_projection_matrices"     to = "vo_slamon/send_projection_matrices"/>
        </node>

    </group>

</launch>